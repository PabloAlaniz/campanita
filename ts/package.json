{
  "name": "campanita",
  "version": "0.8.0",
  "description": "Notificaciones con las mismas reglas en cualquier stack: una política, cualquier base, cualquier canal, cualquier bandeja.",
  "license": "MIT",
  "author": "Pablo Alaniz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PabloAlaniz/campanita.git",
    "directory": "ts"
  },
  "homepage": "https://github.com/PabloAlaniz/campanita#readme",
  "bugs": "https://github.com/PabloAlaniz/campanita/issues",
  "keywords": [
    "notifications",
    "notificaciones",
    "inbox",
    "preferences",
    "push",
    "email",
    "cloudflare-workers"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./http": {
      "import": {
        "types": "./dist/http.d.ts",
        "default": "./dist/http.js"
      },
      "require": {
        "types": "./dist/http.d.cts",
        "default": "./dist/http.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude test/d1 --exclude test/postgres",
    "check:package": "pnpm build && publint --strict && attw --pack . --profile node16",
    "prepack": "cp ../LICENSE ./LICENSE && pnpm build",
    "postpack": "rm -f LICENSE",
    "test:d1": "vitest run test/d1",
    "test:pg": "vitest run test/postgres"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "miniflare": "^4.20260730.0",
    "pg": "^8.23.1",
    "postgres": "^4.1.1",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
