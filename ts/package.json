{
  "name": "campanita",
  "version": "0.2.0",
  "description": "Notificaciones con las mismas reglas en cualquier stack: una política, cualquier base, cualquier canal, cualquier bandeja.",
  "license": "MIT",
  "author": "Pablo Alaniz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PabloAlaniz/campanita.git",
    "directory": "ts"
  },
  "homepage": "https://github.com/PabloAlaniz/campanita#readme",
  "bugs": "https://github.com/PabloAlaniz/campanita/issues",
  "keywords": [
    "notifications",
    "notificaciones",
    "inbox",
    "preferences",
    "push",
    "email",
    "cloudflare-workers"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude test/d1",
    "check:package": "pnpm build && publint --strict && attw --pack . --profile node16",
    "prepack": "cp ../LICENSE ./LICENSE && pnpm build",
    "postpack": "rm -f LICENSE",
    "test:d1": "vitest run test/d1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.0.0",
    "miniflare": "^4.20260730.0",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
