{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/PabloAlaniz/campanita/spec/schemas/vector.schema.json",
  "title": "Vector de conformidad de campanita",
  "type": "object",
  "required": ["spec", "id", "kind", "cases"],
  "additionalProperties": false,
  "properties": {
    "spec": { "const": "0" },
    "id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["politica", "canales", "matriz", "preferencias"] },
    "policy": { "$ref": "#/definitions/policy" },
    "cases": { "type": "array", "minItems": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "politica" } } },
      "then": {
        "not": { "required": ["policy"] },
        "properties": {
          "cases": {
            "items": {
              "type": "object",
              "required": ["note", "policy", "valid"],
              "additionalProperties": false,
              "properties": {
                "note": { "type": "string", "minLength": 1 },
                "policy": { "description": "Cualquier valor JSON: los casos inválidos no cumplen la forma." },
                "valid": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "canales" } } },
      "then": {
        "required": ["policy"],
        "properties": {
          "cases": {
            "items": {
              "type": "object",
              "required": ["category", "overrides", "available", "expect"],
              "additionalProperties": false,
              "properties": {
                "note": { "type": "string", "minLength": 1 },
                "category": { "type": "string" },
                "overrides": { "$ref": "#/definitions/overrides" },
                "available": { "$ref": "#/definitions/channels" },
                "expect": { "$ref": "#/definitions/channels" }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "matriz" } } },
      "then": {
        "required": ["policy"],
        "properties": {
          "cases": {
            "items": {
              "type": "object",
              "required": ["overrides", "available", "expect"],
              "additionalProperties": false,
              "properties": {
                "note": { "type": "string", "minLength": 1 },
                "overrides": { "$ref": "#/definitions/overrides" },
                "available": { "$ref": "#/definitions/channels" },
                "expect": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "required": ["enabled", "locked"],
                      "additionalProperties": false,
                      "properties": {
                        "enabled": { "type": "boolean" },
                        "locked": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "preferencias" } } },
      "then": {
        "required": ["policy"],
        "properties": {
          "cases": {
            "items": {
              "type": "object",
              "required": ["patch", "available", "expect"],
              "additionalProperties": false,
              "properties": {
                "note": { "type": "string", "minLength": 1 },
                "patch": {
                  "type": "object",
                  "description": "Los valores pueden no ser booleanos: es lo que prueba `invalid_value`.",
                  "additionalProperties": { "type": "object" }
                },
                "available": { "$ref": "#/definitions/channels" },
                "expect": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": ["ok", "changes"],
                      "additionalProperties": false,
                      "properties": {
                        "ok": { "const": true },
                        "changes": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["category", "channel", "enabled"],
                            "additionalProperties": false,
                            "properties": {
                              "category": { "type": "string" },
                              "channel": { "type": "string" },
                              "enabled": { "type": "boolean" }
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": ["ok", "error"],
                      "additionalProperties": false,
                      "properties": {
                        "ok": { "const": false },
                        "error": {
                          "type": "object",
                          "required": ["category", "channel", "reason"],
                          "additionalProperties": false,
                          "properties": {
                            "category": { "type": "string" },
                            "channel": { "type": ["string", "null"] },
                            "reason": {
                              "enum": [
                                "unknown_category",
                                "unknown_channel",
                                "invalid_value",
                                "locked",
                                "unavailable"
                              ]
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "channels": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "boolean" }
      }
    },
    "policy": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/definitions/id" },
      "additionalProperties": {
        "type": "object",
        "required": ["inapp"],
        "propertyNames": { "$ref": "#/definitions/id" },
        "additionalProperties": {
          "type": "object",
          "required": ["default"],
          "additionalProperties": false,
          "properties": {
            "default": { "type": "boolean" },
            "locked": { "type": "boolean" }
          }
        }
      }
    }
  }
}
