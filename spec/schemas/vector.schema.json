                }
              }
            }
          }
        },
        "not": {
          "required": [
            "catalog"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "matriz"
          }
        }
      },
      "then": {
        "required": [
          "policy",
          "cases"
