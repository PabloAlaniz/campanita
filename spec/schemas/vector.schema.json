                              "type": "string"
                            },
                            "type": {
                              "type": "string"
                            },
                            "category": {
                              "type": "string"
                            },
                            "title": {
                              "type": "string"
                            },
                            "body": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "action_url": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "payload": {
                              "type": "object"
                            },
                            "scope": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "dedupe_key": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          }
                        }
                      }
