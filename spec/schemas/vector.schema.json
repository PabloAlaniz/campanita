                          "additionalProperties": false,
                          "properties": {
                            "category": {
                              "type": "string"
                            },
                            "channel": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "reason": {
                              "enum": [
                                "unknown_category",
                                "unknown_channel",
                                "invalid_value",
                                "locked",
                                "unavailable"
                              ]
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "not": {
          "required": [
            "catalog"
          ]
        }
      }
