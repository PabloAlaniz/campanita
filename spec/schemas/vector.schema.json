              "required": [
                "note",
                "policy",
                "valid"
              ],
              "additionalProperties": false,
              "properties": {
                "note": {
                  "type": "string",
                  "minLength": 1
                },
                "policy": {
                  "description": "Cualquier valor JSON: los casos inválidos no cumplen la forma."
                },
                "valid": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "required": [
          "cases"
        ]
      }
    },
    {
