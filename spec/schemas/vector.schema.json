                            "additionalProperties": false,
                            "properties": {
                              "category": {
                                "type": "string"
                              },
                              "channel": {
                                "type": "string"
                              },
                              "enabled": {
                                "type": "boolean"
                              }
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "ok",
                        "error"
