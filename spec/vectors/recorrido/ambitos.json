  "email",
  "push",
  "sms"
 ],
 "steps": [
  {
   "note": "ana, sin ámbito: quiere email",
   "op": "save",
   "recipient_id": "ana",
   "scope": null,
   "changes": [
    {
     "category": "activity",
     "channel": "email",
     "enabled": true
    }
   ],
   "expect": null
