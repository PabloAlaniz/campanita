   "payload": {},
   "expect": {
    "ok": false,
    "error": {
     "reason": "missing_variable",
     "detail": "b"
    }
   }
  },
  {
   "note": "la primera está mal y la segunda falta",
   "template": "{a} {b}",
   "payload": {
    "a": null
   },
   "expect": {
    "ok": false,
    "error": {
     "reason": "invalid_variable",
     "detail": "a"
    }
