{
 "spec": "0",
 "id": "plantilla/render",
 "kind": "plantilla",
 "cases": [
  {
   "note": "sin variables",
   "template": "Hola",
   "payload": {},
   "expect": {
    "ok": true,
    "text": "Hola"
   }
  },
  {
   "note": "texto vacío",
   "template": "",
   "payload": {},
   "expect": {
    "ok": true,
    "text": ""
   }
  },
  {
   "note": "una variable",
   "template": "Hola {name}",
   "payload": {
    "name": "Ana"
   },
   "expect": {
    "ok": true,
    "text": "Hola Ana"
   }
  },
  {
   "note": "la misma variable dos veces",
   "template": "{a} y {a}",
   "payload": {
    "a": "x"
   },
   "expect": {
    "ok": true,
    "text": "x y x"
   }
  },
  {
   "note": "dos variables pegadas",
   "template": "{a}{b}",
   "payload": {
    "a": "1",
    "b": "2"
   },
   "expect": {
    "ok": true,
    "text": "12"
   }
  },
  {
   "note": "sólo una variable",
   "template": "{a}",
   "payload": {
    "a": "todo"
   },
   "expect": {
    "ok": true,
    "text": "todo"
   }
  },
  {
   "note": "sobran claves en el payload",
   "template": "{a}",
   "payload": {
    "a": "x",
    "b": "no se usa"
   },
   "expect": {
    "ok": true,
    "text": "x"
   }
  },
  {
   "note": "llaves literales",
   "template": "{{así}}",
   "payload": {},
   "expect": {
    "ok": true,
    "text": "{así}"
   }
  },
  {
   "note": "llave literal y variable",
   "template": "{{{a}}}",
   "payload": {
    "a": "x"
   },
   "expect": {
    "ok": true,
    "text": "{x}"
   }
  },
  {
   "note": "llaves literales sueltas",
   "template": "a }} b {{ c",
   "payload": {},
   "expect": {
    "ok": true,
    "text": "a } b { c"
   }
  },
  {
   "note": "el valor no se vuelve a interpretar",
   "template": "{a}",
   "payload": {
    "a": "{b}"
   },
   "expect": {
    "ok": true,
    "text": "{b}"
   }
  },
  {
   "note": "un valor con llaves dobles queda igual",
   "template": "{a}",
   "payload": {
    "a": "{{x}}"
   },
   "expect": {
    "ok": true,
    "text": "{{x}}"
   }
  },
  {
   "note": "valor vacío",
   "template": "[{a}]",
   "payload": {
    "a": ""
   },
   "expect": {
    "ok": true,
    "text": "[]"
   }
  },
  {
   "note": "texto fuera del plano básico",
   "template": "🔔 {a} ñandú",
   "payload": {
    "a": "😀"
   },
   "expect": {
    "ok": true,
    "text": "🔔 😀 ñandú"
   }
  },
  {
   "note": "nombre con guion bajo y dígitos",
   "template": "{user_2}",
   "payload": {
    "user_2": "ok"
   },
   "expect": {
    "ok": true,
    "text": "ok"
   }
  },
  {
   "note": "nombre de 64 caracteres",
   "template": "{aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}",
   "payload": {
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "ok"
   },
   "expect": {
    "ok": true,
    "text": "ok"
   }
  },
  {
   "note": "entero",
