   "payload": {
    "n": 0
   },
   "expect": {
    "ok": true,
    "text": "0"
   }
  },
  {
   "note": "entero negativo",
   "template": "{n}",
   "payload": {
    "n": -12
   },
   "expect": {
    "ok": true,
    "text": "-12"
   }
