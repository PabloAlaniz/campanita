   "expect": {
    "ok": true,
    "text": "9007199254740991"
   }
  },
  {
   "note": "el menor entero seguro",
   "template": "{n}",
   "payload": {
    "n": -9007199254740991
   },
   "expect": {
    "ok": true,
    "text": "-9007199254740991"
   }
  },
  {
   "note": "un decimal sin parte fraccionaria es un entero",
   "template": "{n}",
   "payload": {
    "n": 3.0
   },
   "expect": {
    "ok": true,
    "text": "3"
   }
  },
  {
   "note": "cero negativo",
   "template": "{n}",
   "payload": {
    "n": -0.0
   },
   "expect": {
    "ok": true,
    "text": "0"
   }
  },
  {
   "note": "entero fuera del rango seguro",
   "template": "{n}",
   "payload": {
    "n": 9007199254740992
   },
   "expect": {
    "ok": false,
    "error": {
     "reason": "invalid_variable",
     "detail": "n"
    }
   }
  },
  {
   "note": "decimal",
   "template": "{n}",
   "payload": {
    "n": 1.5
   },
   "expect": {
    "ok": false,
    "error": {
     "reason": "invalid_variable",
     "detail": "n"
    }
   }
  },
  {
   "note": "booleano",
   "template": "{a}",
   "payload": {
    "a": true
   },
   "expect": {
    "ok": false,
    "error": {
     "reason": "invalid_variable",
     "detail": "a"
    }
   }
  },
  {
   "note": "nulo",
   "template": "{a}",
   "payload": {
    "a": null
   },
   "expect": {
    "ok": false,
    "error": {
     "reason": "invalid_variable",
     "detail": "a"
    }
   }
  },
  {
   "note": "lista",
   "template": "{a}",
   "payload": {
